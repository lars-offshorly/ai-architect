# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4.1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# Pinecone Configuration
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX=your_index_name
PINECONE_HOST=your_index_host
PINECONE_BUNDLE_TEMPLATES_NAMESPACE=bundle_templates

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
DB_POOL_MAX_SIZE=20

# App Configuration
DEBUG=True
LOG_LEVEL=INFO

# AI Engine Latency/Logic settings
CLASSIFIER_TEMPERATURE=0.0
CONVERSATIONAL_TEMPERATURE=0.3
ASSEMBLER_TEMPERATURE=0.2

# Bundle Classification Confidence Thresholds (AD-4)
CONFIDENCE_PROCEED_THRESHOLD=0.75
CONFIDENCE_SUGGEST_THRESHOLD=0.50
SCORE_GAP_MINIMUM=0.15
MAX_CLARIFICATION_TURNS=3

# Security
JWT_SECRET=your_jwt_secret
JWT_ALGORITHM=HS256
RATE_LIMIT_PER_MINUTE=60

# Observability
SENTRY_DSN=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ai-architect
