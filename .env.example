# Core
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5-mini
DEBUG=True
LOG_LEVEL=INFO

# Agent tuning
CLASSIFIER_TEMPERATURE=0.0
CONVERSATIONAL_TEMPERATURE=0.3
ASSEMBLER_TEMPERATURE=0.2

# Classification and flow behavior
CONFIDENCE_THRESHOLD=0.6
TOP_K_BUNDLES=3
CONFIDENCE_PROCEED_THRESHOLD=0.75
CONFIDENCE_SUGGEST_THRESHOLD=0.50
SCORE_GAP_MINIMUM=0.15
MAX_CLARIFICATION_TURNS=3

# Templates
TEMPLATES_DIR=src/templates/bundles
BUNDLE_REGISTRY_PATH=src/templates/bundle_registry.yaml

# Security
REDIS_URL=redis://localhost:6379/0
DEV_BYPASS=false
RATE_LIMIT_PER_MINUTE=60

# Feature flags
ENABLE_MOCK_ENDPOINTS=false

# Observability
SENTRY_DSN=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ai-architect

