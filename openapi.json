        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppPayloadResponseSchema"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/sessions/{session_id}/preview/early": {
      "post": {
        "tags": [
          "preview"
        ],
        "summary": "Generate Early Preview",
        "description": "Generate a preview without requiring bundle confirmation.\n\nUses the best available bundle key in priority order:\n  selected > preselected > latest classification > all_microservices fallback.\nAlways returns a warning indicating the preview may be incomplete.\nSupports Lars scenario #3: \"preview system now\" from the very first prompt.",
        "operationId": "generate_early_preview_sessions__session_id__preview_early_post",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppPayloadResponseSchema"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/sessions/{session_id}/preview/edit": {
      "post": {
        "tags": [
          "preview"
        ],
        "summary": "Edit Preview",
        "description": "Apply a natural-language edit to an existing preview payload.\n\nAccepts the full current preview + an instruction string.\nParses the instruction into an EditAction, applies it to the payload,\nand returns the updated AppPayloadResponseSchema.\n\nNo pipeline re-run — purely client-side JSON mutation.",
        "operationId": "edit_preview_sessions__session_id__preview_edit_post",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EditPreviewRequestSchema"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppPayloadResponseSchema"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
