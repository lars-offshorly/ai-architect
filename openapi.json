    "/sessions/{session_id}/app": {
      "post": {
        "tags": [
          "app"
        ],
        "summary": "Generate App Payload",
        "description": "Assembles the final app payload for a confirmed session.\n\nLoads the static app.json from templates, validates it against the\nprovided dummy_data, and packages the result into the AppPayload contract.",
        "operationId": "generate_app_payload_sessions__session_id__app_post",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerateAppRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppPayloadResponseSchema"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
