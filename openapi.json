    "/sessions/{session_id}/preview": {
      "post": {
        "tags": [
          "preview"
        ],
        "summary": "Generate Preview",
        "description": "Run the preview pipeline for a confirmed session and return the AppPayload.",
        "operationId": "generate_preview_sessions__session_id__preview_post",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
