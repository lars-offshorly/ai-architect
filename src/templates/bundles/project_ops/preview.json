{
  "schema_version": "1.0",
  "bundle_key": "project_ops",
  "display_name": "Project Operations",
  "modules": ["tasks", "timelines", "milestones", "dashboard"],
  "stores": {
    "tasks": [
      {"id": "task-001", "title": "Kickoff Meeting", "status": "done", "priority": "high", "assignee": "{{team_lead}}", "project": "{{project_name}}", "due_date": "2026-01-10T09:00:00Z"},
      {"id": "task-002", "title": "Requirements Gathering", "status": "in_progress", "priority": "high", "assignee": "{{team_member}}", "project": "{{project_name}}", "due_date": "2026-01-20T17:00:00Z"}
    ],
    "milestones": [
      {"id": "ms-001", "name": "Phase 1 Complete", "status": "pending", "target_date": "2026-02-01T00:00:00Z", "project": "{{project_name}}"},
      {"id": "ms-002", "name": "MVP Launch", "status": "pending", "target_date": "2026-03-15T00:00:00Z", "project": "{{project_name}}"}
    ],
    "kpis": [
      {"id": "kpi-001", "label": "On-Time Delivery", "value": 78, "unit": "%", "trend": "up"},
      {"id": "kpi-002", "label": "Active Projects", "value": 4, "unit": "projects", "trend": "stable"},
      {"id": "kpi-003", "label": "Open Tasks", "value": 12, "unit": "tasks", "trend": "down"}
    ],
    "dashboard_widgets": [
      {"id": "widget-001", "type": "project_timeline", "title": "Project Timeline", "position": {"row": 0, "col": 0, "width": 3, "height": 2}},
      {"id": "widget-002", "type": "kpi_grid", "title": "Delivery Metrics", "position": {"row": 2, "col": 0, "width": 3, "height": 1}}
    ]
  },
  "metadata": {
    "customizable_fields": ["company_name", "project_names", "team_names", "milestone_labels"]
  }
}
