{
  "schema_version": "1.0",
  "bundle_key": "legal_services",
  "config": {
    "permission_services": ["tickets", "kpi", "notifications"],
    "landing_pages": [
      {"service": "ticketing", "path": "/tickets"},
      {"service": "dashboard", "path": "/dashboard"}
    ],
    "work_order_statuses": ["open", "in_progress", "on_hold", "resolved", "closed"],
    "work_order_priorities": ["low", "medium", "high", "urgent"],
    "service_types": ["research", "drafting", "review", "filing", "court_appearance"],
    "kpi_definitions": [
      {"key": "avg_case_duration", "label": "Average Case Duration", "unit": "duration"},
      {"key": "cases_per_attorney", "label": "Cases per Attorney", "unit": "count"},
      {"key": "case_load_distribution", "label": "Case Load Distribution", "unit": "percentage"},
      {"key": "upcoming_deadlines", "label": "Upcoming Deadlines", "unit": "count"}
    ]
  },
  "stores_contract": {
    "required": ["tickets", "kpis"],
    "optional": ["projects", "tasks", "weaves", "dashboard_widgets", "smart_vault", "announcements"]
  },
  "slots_used": ["primary_use_case", "company_name", "industry_hint"]
}