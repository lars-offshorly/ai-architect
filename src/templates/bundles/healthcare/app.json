      {"key": "active_work_items", "label": "Active Work Items", "unit": "count"},
      {"key": "sla_compliance", "label": "SLA Compliance", "unit": "percentage"}
    ]
  },
  "stores_contract": {
    "required": ["tickets", "kpis"],
    "optional": ["projects", "tasks", "weaves", "dashboard_widgets", "announcements"]
