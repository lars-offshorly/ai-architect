{
  "schema_version": "1.0",
  "bundle_key": "construction",
  "config": {
    "permission_services": ["projects", "kpi", "notifications"],
    "landing_pages": [
      {"service": "project_mgmt", "path": "/projects"},
      {"service": "dashboard", "path": "/dashboard"}
    ],
    "task_statuses": ["backlog", "in_progress", "review", "done", "blocked"],
    "task_priorities": ["low", "medium", "high", "critical"],
    "milestone_statuses": ["pending", "at_risk", "achieved"],
    "kpi_definitions": [
      {"key": "on_time_delivery_rate", "label": "On-Time Delivery Rate", "unit": "percentage"},
      {"key": "project_health_status", "label": "Project Health Status", "unit": "percentage"},
      {"key": "active_work_items", "label": "Active Work Items", "unit": "count"}
    ]
  },
  "stores_contract": {
    "required": ["projects", "tasks", "kpis"],
    "optional": ["tickets", "weaves", "dashboard_widgets", "announcements", "calendar"]
  },
  "slots_used": ["primary_use_case", "company_name", "industry_hint"]
}