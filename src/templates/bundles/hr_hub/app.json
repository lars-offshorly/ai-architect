{
  "schema_version": "1.0",
  "bundle_key": "hr_management",
  "config": {
    "permission_services": ["hr_hub", "kpi", "notifications"],
    "landing_pages": [
      {"service": "hr_hub", "path": "/hr-hub"},
      {"service": "dashboard", "path": "/dashboard"}
    ],
    "ticket_categories": ["leave", "onboarding", "offboarding", "policy", "payroll", "other"],
    "default_statuses": ["open", "in_progress", "on_hold", "resolved", "closed"],
    "default_priorities": ["low", "medium", "high", "urgent"],
    "queue_names": ["Leave Requests", "Onboarding", "General HR"],
    "kpi_definitions": [
      {"key": "active_headcount", "label": "Active Headcount", "unit": "count"},
      {"key": "attendance_rate", "label": "Attendance Rate", "unit": "percentage"},
      {"key": "capacity_utilization", "label": "Capacity Utilization", "unit": "percentage"}
    ]
  },
  "stores_contract": {
    "required": ["tickets", "kpis"],
    "optional": ["projects", "tasks", "weaves", "dashboard_widgets"]
  },
  "slots_used": ["team_size", "primary_use_case", "company_name", "industry_hint"]
}
