{
  "schema_version": "1.0",
  "bundle_key": "all_microservices",
  "config": {
    "permission_services": ["hr_hub", "projects", "tickets", "kpi", "notifications"],
    "landing_pages": [
      {"service": "hr_hub", "path": "/hr-hub"},
      {"service": "dashboard", "path": "/dashboard"}
    ],
    "ticket_categories": ["leave", "onboarding", "offboarding", "policy", "payroll", "other"],
    "default_statuses": ["open", "in_progress", "on_hold", "resolved", "closed"],
    "default_priorities": ["low", "medium", "high", "urgent"],
    "queue_names": ["Leave Requests", "Onboarding", "General HR"],
    "kpi_definitions": [
      {"key": "on_time_delivery_rate", "label": "On-Time Delivery Rate", "unit": "percentage"},
      {"key": "project_health_status", "label": "Project Health Status", "unit": "percentage"},
      {"key": "avg_resolution_time", "label": "Average Resolution Time", "unit": "duration"},
      {"key": "active_headcount", "label": "Active Headcount", "unit": "count"},
      {"key": "sla_compliance", "label": "SLA Compliance", "unit": "percentage"},
      {"key": "capacity_utilization", "label": "Capacity Utilization", "unit": "percentage"}
    ]
  },
  "stores_contract": {
    "required": ["tickets", "projects", "tasks", "kpis"],
    "optional": ["weaves", "dashboard_widgets"]
  },
  "slots_used": ["primary_use_case", "company_name", "industry_hint", "department_names", "status_labels"]
}