{
  "schema_version": "1.0",
  "bundle_key": "generic",
  "display_name": "Custom Workspace",
  "modules": ["tickets", "dashboard"],
  "stores": {
    "tickets": [
      {"id": "ticket-001", "title": "{{task_title}}", "status": "pending", "priority": "medium", "assignee": "{{assignee}}", "created_at": "2026-01-15T09:00:00Z"},
      {"id": "ticket-002", "title": "{{task_title_2}}", "status": "in_progress", "priority": "high", "assignee": "{{assignee}}", "created_at": "2026-01-16T10:00:00Z"}
    ],
    "kpis": [
      {"id": "kpi-001", "label": "Open Items", "value": 5, "unit": "items", "trend": "stable"},
      {"id": "kpi-002", "label": "Completed This Week", "value": 3, "unit": "items", "trend": "up"}
    ],
    "dashboard_widgets": [
      {"id": "widget-001", "type": "ticket_summary", "title": "Work Overview", "position": {"row": 0, "col": 0, "width": 3, "height": 1}},
      {"id": "widget-002", "type": "kpi_grid", "title": "Metrics", "position": {"row": 1, "col": 0, "width": 3, "height": 1}}
    ]
  },
  "metadata": {
    "customizable_fields": ["company_name", "primary_use_case"]
  }
}
