{
  "schema_version": "1.0",
  "bundle_key": "field_service",
  "display_name": "Field Service",
  "modules": ["work_orders", "scheduling", "forms", "dashboard"],
  "stores": {
    "work_orders": [
      {"id": "wo-001", "title": "AC Repair — {{client_name}}", "status": "dispatched", "priority": "high", "technician": "{{technician}}", "zone": "{{zone}}", "scheduled_date": "2026-01-20T09:00:00Z"},
      {"id": "wo-002", "title": "Routine Inspection — {{client_name_2}}", "status": "pending", "priority": "medium", "technician": "{{technician_2}}", "zone": "{{zone}}", "scheduled_date": "2026-01-21T10:00:00Z"}
    ],
    "scheduling": [
      {"id": "sched-001", "technician": "{{technician}}", "zone": "{{zone}}", "available_slots": 3, "booked_slots": 5},
      {"id": "sched-002", "technician": "{{technician_2}}", "zone": "{{zone_2}}", "available_slots": 2, "booked_slots": 4}
    ],
    "kpis": [
      {"id": "kpi-001", "label": "SLA Compliance", "value": 91, "unit": "%", "trend": "up"},
      {"id": "kpi-002", "label": "Open Work Orders", "value": 8, "unit": "orders", "trend": "stable"},
      {"id": "kpi-003", "label": "Avg Job Duration", "value": 3.2, "unit": "hours", "trend": "down"}
    ],
    "dashboard_widgets": [
      {"id": "widget-001", "type": "dispatch_map", "title": "Field Dispatch", "position": {"row": 0, "col": 0, "width": 3, "height": 2}},
      {"id": "widget-002", "type": "kpi_grid", "title": "Service Metrics", "position": {"row": 2, "col": 0, "width": 3, "height": 1}}
    ]
  },
  "metadata": {
    "customizable_fields": ["company_name", "technician_names", "zone_names", "service_types"]
  }
}
