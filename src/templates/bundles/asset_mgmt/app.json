{
  "schema_version": "1.0",
  "bundle_key": "asset_mgmt",
  "display_name": "Asset Management",
  "modules": ["assets", "maintenance", "tickets", "dashboard"],
  "config": {
    "asset_statuses": ["operational", "maintenance", "decommissioned", "retired"],
    "maintenance_types": ["scheduled", "preventive", "corrective", "emergency"],
    "maintenance_statuses": ["scheduled", "in_progress", "completed", "overdue"],
    "kpi_definitions": [
      {"key": "asset_uptime", "label": "Asset Uptime", "unit": "%"},
      {"key": "pending_maintenance", "label": "Pending Maintenance", "unit": "items"},
      {"key": "avg_repair_time", "label": "Avg Repair Time", "unit": "days"}
    ]
  },
  "slots_used": ["asset_types", "location_count", "company_name"]
}
