{
  "dashboard_name": "Sales Dashboard Template",
  "source": "analytics",
  "report": "# Sales Dashboard\n\n## Overview\nThis dashboard gives Template sales leaders a real-time view of pipeline health, forecast reliability, and seller productivity. It supports sales managers, RevOps, and account executives in spotting at-risk deals, stalled proposals, and quota gaps.\n\n## Key Metrics\n- Total Leads: 12\n- Active Opportunities: 96\n- Proposals Sent: 2\n- Closed Deals: 102\n- Weighted Pipeline Value: P 18.2M\n- Quota Attainment: 84%\n\n## Insights\n- Pipeline is healthy at the Qualified and Proposal stages; Negotiation stage is thinning\n- Two large opportunities have had no activity in >14 days \u2014 follow-up needed\n- Win rate has climbed 4pts versus last quarter, driven by better lead qualification",
  "widgets": [
    {
      "type": "number",
      "name": "Total Leads",
      "calculation": {
        "datasets": [
          {
            "name": "Total Leads",
            "data_source": "leads",
            "module": "Sales",
            "operation": "count"
          }
        ],
        "expected_value": "12"
      }
    },
    {
      "type": "number",
      "name": "Active Opportunities",
      "calculation": {
        "datasets": [
          {
            "name": "Active Opportunities",
            "data_source": "opportunities",
            "module": "Sales",
            "operation": "count"
          }
        ],
        "expected_value": "96"
      }
    },
    {
      "type": "number",
      "name": "Proposals Sent",
      "calculation": {
        "datasets": [
          {
            "name": "Proposals Sent",
            "data_source": "proposals",
            "module": "Sales",
            "operation": "count"
          }
        ],
        "expected_value": "2"
      }
    },
    {
      "type": "number",
      "name": "Closed Deals",
      "calculation": {
        "datasets": [
          {
            "name": "Closed Deals",
            "data_source": "opportunities",
            "module": "Sales",
            "operation": "count",
            "filters": {
              "stage": "Closed"
            }
          }
        ],
        "expected_value": "102"
      }
    },
    {
      "type": "bar",
      "title": "Sales Pipeline",
      "description": "Opportunity count across pipeline stages.",
      "data_config": {
        "module": "Sales",
        "data_source": "opportunities",
        "group_by": [
          "stage"
        ],
        "fields": [
          "Lead",
          "Qualified",
          "Proposal",
          "Negotiation",
          "Closed"
        ],
        "aggregation": "count"
      }
    },
    {
      "type": "line",
      "title": "Revenue Forecast",
      "description": "Expected revenue per month from weighted pipeline over the next 12 months.",
      "data_config": {
        "module": "Sales",
        "data_source": "opportunities",
        "group_by": [
          "custom_dates"
        ],
        "date_from": null,
        "date_to": null,
        "date_interval": "monthly",
        "aggregation": "sum"
      }
    },
    {
      "type": "list",
      "name": "Active Opportunities",
      "description": "All active deals with client, stage, value, close date, and owner.",
      "data_config": {
        "module": "Sales",
        "data_source": "opportunities",
        "group_by": [
          "name",
          "client",
          "stage",
          "value",
          "close_date",
          "owner"
        ]
      },
      "column_count": 6,
      "column_width": 150
    },
    {
      "type": "list",
      "name": "My Sales Tasks",
      "description": "Open tasks assigned to the current rep.",
      "data_config": {
        "module": "Sales",
        "data_source": "tasks",
        "group_by": [
          "title",
          "client",
          "due_date",
          "status"
        ]
      },
      "column_count": 4,
      "column_width": 180
    },
    {
      "type": "list",
      "name": "Proposal Tracker",
      "description": "Proposals sent to clients with status and deal value.",
      "data_config": {
        "module": "Sales",
        "data_source": "proposals",
        "group_by": [
          "client",
          "name",
          "date_sent",
          "status",
          "value"
        ]
      },
      "column_count": 5,
      "column_width": 160
    },
    {
      "type": "list",
      "name": "Upcoming Deal Closures",
      "description": "Deals expected to close in the next 30 days.",
      "data_config": {
        "module": "Sales",
        "data_source": "upcoming_closures",
        "group_by": [
          "client",
          "deal_value",
          "close_date"
        ]
      },
      "column_count": 3,
      "column_width": 200
    },
    {
      "type": "hbar",
      "title": "Sales Rep Performance",
      "description": "Deals closed and revenue per rep in the current quarter.",
      "data_config": {
        "module": "Sales",
        "data_source": "sales_rep_performance",
        "group_by": [
          "rep"
        ],
        "fields": [
          "deals",
          "revenue"
        ],
        "aggregation": "sum"
      }
    }
  ]
}
