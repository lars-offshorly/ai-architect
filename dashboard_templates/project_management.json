{
    "dashboard_name": "Project Management Dashboard Template",
    "source": "analytics",
    "report": "# Project Management Dashboard\n\n## Overview\nThis dashboard tracks project progress, resource allocation, and task completion rates across the organization. It highlights critical path items and potential bottlenecks in delivery.\n\n## Key Metrics\n- Active Projects: 24\n- Critical Tasks: 12\n- On-time Delivery Rate: 88%\n\n## Insights\n- Most projects are currently on track, but several in the 'Infrastructure' category are seeing delays.\n- Resource utilization is peaked at 95% in the Software Development department.\n- Project velocity has increased by 10% following the adoption of new agile tools.",
    "widgets": [
        {
            "type": "number",
            "name": "Active Projects",
            "calculation": {
                "datasets": [
                    {
                        "name": "Active Projects",
                        "data_source": "projects",
                        "module": "Projects",
                        "operation": "count",
                        "filters": {
                            "projectStatus": "Active"
                        }
                    }
                ],
                "expected_value": "24"
            }
        },
        {
            "type": "number",
            "name": "Critical Tasks Pending",
            "calculation": {
                "datasets": [
                    {
                        "name": "Critical Tasks",
                        "data_source": "tasks",
                        "module": "Projects",
                        "operation": "count",
                        "filters": {
                            "priority": "Critical",
                            "status": "In Progress"
                        }
                    }
                ],
                "expected_value": "12"
            }
        },
        {
            "type": "hbar",
            "title": "Project Status Distribution",
            "description": "Number of projects currently in each status phase.",
            "data_config": {
                "module": "Projects",
                "data_source": "projects",
                "group_by": [
                    "projectStatus"
                ],
                "fields": [
                    "Planning",
                    "Implementation",
                    "Testing",
                    "Handoff",
                    "Completed"
                ],
                "aggregation": "count"
            }
        },
        {
            "type": "pie",
            "title": "Task Priority Breakdown",
            "description": "Distribution of all tasks by their assigned priority level.",
            "data_config": {
                "module": "Projects",
                "data_source": "tasks",
                "group_by": [
                    "priority"
                ],
                "fields": [
                    "Critical",
                    "High",
                    "Medium",
                    "Low"
                ],
                "aggregation": "count"
            }
        },
        {
            "type": "line",
            "title": "Velocity Trend (Tasks Completed)",
            "description": "Weekly trend of completed tasks across all projects.",
            "data_config": {
                "module": "Projects",
                "data_source": "tasks",
                "group_by": [
                    "custom_dates"
                ],
                "date_from": "2024-01-01",
                "date_to": "2024-03-31",
                "date_interval": "weekly",
                "aggregation": "count",
                "filters": {
                    "status": "Completed"
                }
            }
        },
        {
            "type": "list",
            "name": "Project Milestones",
            "description": "Upcoming key milestones for high-priority projects.",
            "data_config": {
                "module": "Projects",
                "data_source": "projects",
                "group_by": [
                    "projectTitle",
                    "milestoneName",
                    "dueDate",
                    "responsibleParty"
                ]
            },
            "column_count": 4,
            "column_width": 200
        }
    ]
}
