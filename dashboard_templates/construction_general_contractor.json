{
  "dashboard_name": "General Contractor Dashboard Template",
  "source": "analytics",
  "report": "# General Contractor Operations Report\n\n## Overview\nThis dashboard provides a real-time view of all active construction projects managed by Apex Build Group, tracking schedule adherence, open RFIs, safety incidents, and budget variance across commercial build sites.\n\n## Key Metrics\n- Active Projects: 12\n- On-Schedule Rate: 83.3%\n- Open RFIs: 27\n- Safety Incident Rate: 1.4%\n- Budget Variance: 4.8%\n\n## Insights\n- Over 80% of projects are on schedule, indicating strong project controls but RFI volume may become a risk if unresolved items exceed 30.\n- Budget variance of 4.8% is within acceptable commercial build tolerance; monitor the Airport Terminal Expansion for scope creep.\n- Safety incident rate should be brought below 1.0% — prioritize toolbox talks on active sites.",
  "widgets": [
    {
      "type": "number",
      "name": "Active Projects",
      "calculation": {
        "datasets": [
          {
            "name": "Active Projects",
            "data_source": "projects",
            "module": "Projects",
            "operation": "count",
            "filters": {"status": ["In Progress"]}
          }
        ],
        "expected_value": "12"
      }
    },
    {
      "type": "number",
      "name": "On-Schedule Rate",
      "calculation": {
        "datasets": [
          {
            "name": "On-Schedule Rate",
            "data_source": "projects",
            "module": "Projects",
            "operation": "percentage",
            "filters": {"on_schedule": true}
          }
        ],
        "expected_value": "83.3%"
      }
    },
    {
      "type": "bar",
      "name": "Project Status Distribution",
      "calculation": {
        "datasets": [
          {
            "name": "Projects by Status",
            "data_source": "projects",
            "module": "Projects",
            "operation": "count",
            "filters": {},
            "group_by": "status"
          }
        ],
        "expected_value": "grouped bar"
      }
    },
    {
      "type": "line",
      "name": "RFI Volume Trend",
      "data_config": {
        "datasets": [
          {
            "name": "RFI Volume",
            "data_source": "ticketing",
            "module": "Projects",
            "operation": "count",
            "filters": {"type": "RFI"}
          }
        ],
        "group_by": ["custom_dates"],
        "date_from": "2025-01-01",
        "date_to": "2025-12-31",
        "date_interval": "monthly",
        "aggregation": "count"
      }
    },
    {
      "type": "bar",
      "name": "Budget vs Actual by Project",
      "calculation": {
        "datasets": [
          {
            "name": "Budgeted Cost",
            "data_source": "projects",
            "module": "Projects",
            "operation": "sum",
            "filters": {},
            "field": "budget"
          },
          {
            "name": "Actual Cost",
            "data_source": "projects",
            "module": "Projects",
            "operation": "sum",
            "filters": {},
            "field": "actual_cost"
          }
        ],
        "expected_value": "comparative bar"
      }
    },
    {
      "type": "list",
      "name": "Open RFIs & Work Items",
      "calculation": {
        "datasets": [
          {
            "name": "Open Items",
            "data_source": "ticketing",
            "module": "Projects",
            "operation": "list",
            "filters": {"status": ["Open", "In Progress"]}
          }
        ],
        "expected_value": "item list"
      },
      "column_count": 4,
      "column_width": 200
    }
  ]
}
