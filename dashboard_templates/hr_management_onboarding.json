{
  "dashboard_name": "Onboarding & Offboarding Dashboard Template",
  "source": "analytics",
  "report": "# Onboarding & Offboarding Dashboard\n\n## Overview\nThis dashboard gives the Template people operations team a day-one to day-exit view of employee lifecycle events. It supports HRBPs, IT, and department heads in spotting stalled onboarding plans, incomplete clearances, and upcoming probation reviews.\n\n## Key Metrics\n- New Hires This Month: 12\n- Onboarding In Progress: 9\n- Exits This Month: 4\n- Probation Reviews Due: 5\n\n## Insights\n- IT asset provisioning remains the most common onboarding blocker\n- Exit clearances are averaging 6 days \u2014 inside the 10-day target\n- Probation reviews are clustered in the next two weeks \u2014 manager capacity risk",
  "widgets": [
    {
      "type": "number",
      "name": "New Hires This Month",
      "calculation": {
        "datasets": [
          {
            "name": "New Hires",
            "data_source": "employees",
            "module": "HR Hub",
            "operation": "count",
            "filters": {
              "status": "Onboarding"
            }
          }
        ],
        "expected_value": "12"
      }
    },
    {
      "type": "number",
      "name": "Onboarding In Progress",
      "calculation": {
        "datasets": [
          {
            "name": "Active Onboarding",
            "data_source": "onboarding_plans",
            "module": "HR Hub",
            "operation": "count",
            "filters": {
              "status": "In Progress"
            }
          }
        ],
        "expected_value": "9"
      }
    },
    {
      "type": "number",
      "name": "Exits This Month",
      "calculation": {
        "datasets": [
          {
            "name": "Offboarding Cases",
            "data_source": "offboarding_cases",
            "module": "HR Hub",
            "operation": "count",
            "filters": {
              "status": "In Progress"
            }
          }
        ],
        "expected_value": "4"
      }
    },
    {
      "type": "number",
      "name": "Probation Reviews Due",
      "calculation": {
        "datasets": [
          {
            "name": "Probation Reviews",
            "data_source": "requests",
            "module": "HR Hub",
            "operation": "count",
            "filters": {
              "request_type": "Probation Review",
              "status": "Pending"
            }
          }
        ],
        "expected_value": "5"
      }
    },
    {
      "type": "pie",
      "title": "Onboarding Stage Breakdown",
      "description": "Where active new hires are in their onboarding plan.",
      "data_config": {
        "module": "HR Hub",
        "data_source": "onboarding_plans",
        "group_by": [
          "stage"
        ],
        "fields": [
          "Pre-boarding",
          "Day 1",
          "Week 1",
          "Month 1",
          "Complete"
        ],
        "aggregation": "count"
      }
    },
    {
      "type": "pie",
      "title": "Exit Reason Distribution",
      "description": "Categorized reasons for active offboarding cases.",
      "data_config": {
        "module": "HR Hub",
        "data_source": "offboarding_cases",
        "group_by": [
          "reason"
        ],
        "fields": [
          "Resignation",
          "End of Contract",
          "Retirement",
          "Termination",
          "Other"
        ],
        "aggregation": "count"
      }
    },
    {
      "type": "bar",
      "title": "New Hires by Department",
      "description": "Distribution of this month's new hires across departments.",
      "data_config": {
        "module": "HR Hub",
        "data_source": "employees",
        "group_by": [
          "department"
        ],
        "fields": [
          "Engineering",
          "Sales",
          "Marketing",
          "Operations",
          "HR"
        ],
        "aggregation": "count"
      }
    },
    {
      "type": "line",
      "title": "Lifecycle Events Trend",
      "description": "Monthly new hires and exits over the last 12 months.",
      "data_config": {
        "module": "HR Hub",
        "data_source": "employees",
        "group_by": [
          "custom_dates"
        ],
        "date_from": null,
        "date_to": null,
        "date_interval": "monthly",
        "aggregation": "count"
      }
    },
    {
      "type": "list",
      "name": "Active Onboarding Plans",
      "description": "New hires currently being onboarded, with owner and target completion date.",
      "data_config": {
        "module": "HR Hub",
        "data_source": "onboarding_plans",
        "group_by": [
          "employee",
          "department",
          "stage",
          "owner",
          "target_date"
        ]
      },
      "column_count": 5,
      "column_width": 160
    },
    {
      "type": "list",
      "name": "Offboarding Checklists",
      "description": "Exit cases in progress with clearance status.",
      "data_config": {
        "module": "HR Hub",
        "data_source": "offboarding_cases",
        "group_by": [
          "employee",
          "last_working_day",
          "reason",
          "status"
        ]
      },
      "column_count": 4,
      "column_width": 180
    },
    {
      "type": "list",
      "name": "Requests",
      "description": "Lifecycle-related employee requests awaiting HR action.",
      "data_config": {
        "module": "HR Hub",
        "data_source": "requests",
        "group_by": [
          "request_type",
          "employee",
          "status"
        ]
      },
      "column_count": 3,
      "column_width": 200
    }
  ]
}
