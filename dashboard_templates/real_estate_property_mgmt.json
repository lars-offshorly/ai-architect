{
  "dashboard_name": "Property Management Dashboard Template",
  "source": "analytics",
  "report": "# Property Management Operations Report\n\n## Overview\nThis dashboard provides Crestview Property Management with visibility into portfolio occupancy, maintenance request volume, lease renewal pipeline, and rent collection performance across all managed units.\n\n## Key Metrics\n- Total Units Managed: 480\n- Occupancy Rate: 94.2%\n- Open Maintenance Requests: 37\n- Avg Days to Fill Vacancy: 18\n- Rent Collection Rate: 98.1%\n\n## Insights\n- Occupancy at 94.2% is above the 93% benchmark; focus on the 28 vacant units with priority on those beyond 18 days.\n- Rent collection of 98.1% is excellent — the one eviction notice in progress should be resolved to prevent further arrears exposure.\n- 37 open maintenance requests: triage by urgency; the leaking pipe in Unit 214 is a water damage risk if not resolved within 24 hours.",
  "widgets": [
    {
      "type": "number",
      "name": "Total Units",
      "calculation": {
        "datasets": [
          {
            "name": "Total Units",
            "data_source": "projects",
            "module": "Real Estate",
            "operation": "count",
            "filters": {}
          }
        ],
        "expected_value": "480"
      }
    },
    {
      "type": "number",
      "name": "Occupancy Rate",
      "calculation": {
        "datasets": [
          {
            "name": "Occupancy Rate",
            "data_source": "projects",
            "module": "Real Estate",
            "operation": "percentage",
            "filters": {"status": "Occupied"}
          }
        ],
        "expected_value": "94.2%"
      }
    },
    {
      "type": "pie",
      "name": "Maintenance Request Type Breakdown",
      "calculation": {
        "datasets": [
          {
            "name": "Maintenance by Type",
            "data_source": "ticketing",
            "module": "Real Estate",
            "operation": "count",
            "filters": {"type": "Maintenance Request"},
            "group_by": "sub_type"
          }
        ],
        "expected_value": "pie chart"
      }
    },
    {
      "type": "line",
      "name": "Monthly Work Orders Trend",
      "data_config": {
        "datasets": [
          {
            "name": "Work Orders",
            "data_source": "ticketing",
            "module": "Real Estate",
            "operation": "count",
            "filters": {}
          }
        ],
        "group_by": ["custom_dates"],
        "date_from": "2025-01-01",
        "date_to": "2025-12-31",
        "date_interval": "monthly",
        "aggregation": "count"
      }
    },
    {
      "type": "bar",
      "name": "Lease Expiry Pipeline",
      "calculation": {
        "datasets": [
          {
            "name": "Leases Expiring by Month",
            "data_source": "projects",
            "module": "Real Estate",
            "operation": "count",
            "filters": {"type": "Lease Renewal"},
            "group_by": "expiry_month"
          }
        ],
        "expected_value": "bar chart"
      }
    },
    {
      "type": "list",
      "name": "Open Maintenance & Lease Items",
      "calculation": {
        "datasets": [
          {
            "name": "Open Items",
            "data_source": "ticketing",
            "module": "Real Estate",
            "operation": "list",
            "filters": {"status": ["Open", "In Progress"]}
          }
        ],
        "expected_value": "item list"
      },
      "column_count": 4,
      "column_width": 200
    }
  ]
}
